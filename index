    <!-- JavaScript Logic: Gerbang Login Peserta Didik -->
    <script>
        let kelasTerpilihLogin = null;

        function pilihKelasLogin(kelas, btnEl) {
            document.querySelectorAll('.kelas-login-btn').forEach(b => {
                b.classList.remove('border-brand-500', 'bg-brand-50', 'ring-2', 'ring-brand-200');
            });
            btnEl.classList.add('border-brand-500', 'bg-brand-50', 'ring-2', 'ring-brand-200');
            kelasTerpilihLogin = kelas;
            validasiFormLogin();
        }

        function validasiFormLogin() {
            const nama = document.getElementById('login-nama').value.trim();
            const btn = document.getElementById('btn-masuk-portal');
            const isValid = nama.length > 0 && kelasTerpilihLogin;
            btn.disabled = !isValid;
            btn.classList.toggle('opacity-50', !isValid);
            btn.classList.toggle('cursor-not-allowed', !isValid);
            return isValid;
        }

        function masukPortal() {
            const nama = document.getElementById('login-nama').value.trim();
            const errorMsg = document.getElementById('login-error');

            if (!nama || !kelasTerpilihLogin) {
                errorMsg.classList.remove('hidden');
                return;
            }
            errorMsg.classList.add('hidden');

            // Sembunyikan gerbang login, tampilkan portal utama
            document.getElementById('login-gate').style.display = 'none';
            document.getElementById('main-site').classList.remove('hidden');
            document.body.classList.remove('overflow-hidden');
            window.scrollTo(0, 0);

            // Tampilkan info peserta didik di navbar (desktop & mobile)
            const namaTampil = nama.length > 18 ? nama.substring(0, 18) + '…' : nama;

            const badge = document.getElementById('siswa-info-badge');
            document.getElementById('siswa-info-nama').innerText = namaTampil;
            document.getElementById('siswa-info-kelas').innerText = kelasTerpilihLogin;
            badge.classList.remove('hidden');
            badge.classList.add('flex');

            const badgeMobile = document.getElementById('siswa-info-badge-mobile');
            document.getElementById('siswa-info-nama-mobile').innerText = namaTampil;
            document.getElementById('siswa-info-kelas-mobile').innerText = kelasTerpilihLogin;
            badgeMobile.classList.remove('hidden');
        }

        function keluarPortal() {
            if (confirm('Keluar dari portal dan kembali ke halaman login?')) {
                location.reload();
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const inputNama = document.getElementById('login-nama');
            if (inputNama) {
                inputNama.addEventListener('input', validasiFormLogin);
                inputNama.focus();
            }
        });
    </script>

