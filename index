                    } else {
                        btnEl.className = "w-full text-left p-4 rounded-xl flex items-center gap-4 transition-all duration-200 border-2 border-brand-500 bg-brand-50/50 text-slate-900";
                        iconEl.className = "w-10 h-10 rounded-lg bg-brand-500 text-white flex items-center justify-center text-lg shadow-md shrink-0";
