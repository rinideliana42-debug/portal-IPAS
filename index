        // --- 8. Dynamic Quiz Engine (Sistem Kuis Interaktif) ---
        const startScreen = document.getElementById('quiz-start');
        const questionScreen = document.getElementById('quiz-question-container');
        const resultScreen = document.getElementById('quiz-result');
        const questionText = document.getElementById('question-text');
        const optionsContainer = document.getElementById('options-container');
        const nextBtn = document.getElementById('next-btn');
        const counterText = document.getElementById('question-counter');
        const progressBar = document.getElementById('quiz-progress');

        function startQuiz() {
            startScreen.classList.add('hidden');
            questionScreen.classList.remove('hidden');
            resultScreen.classList.add('hidden');
            quizCurrentQuestionIndex = 0;
            quizScore = 0;
            loadQuizQuestion();
        }

        function loadQuizQuestion() {
            quizHasAnswered = false;
            nextBtn.classList.add('hidden');
            nextBtn.disabled = true;

            const questions = IPAS_CURRICULUM[currentActiveBab].kuis;
            const currentQ = questions[quizCurrentQuestionIndex];

            // Progress & Counter
            counterText.innerText = `Soal ${quizCurrentQuestionIndex + 1} dari ${questions.length}`;
            progressBar.style.width = `${((quizCurrentQuestionIndex + 1) / questions.length) * 100}%`;
            
            // Question Text
            questionText.innerText = currentQ.question;

            // Render Options
            optionsContainer.innerHTML = '';
            currentQ.options.forEach((opt, index) => {
                const optBtn = document.createElement('div');
                optBtn.className = 'option-btn border border-slate-200 rounded-xl p-4 cursor-pointer hover:border-brand-500 hover:bg-slate-50 transition-all text-xs sm:text-sm font-medium text-slate-700 flex items-center gap-3';
                optBtn.innerHTML = `
                    <div class="w-7 h-7 rounded-full border border-slate-300 flex items-center justify-center font-bold text-slate-500 option-letter shrink-0">
                        ${String.fromCharCode(65 + index)}
                    </div>
                    <span>${opt}</span>
                `;
                optBtn.onclick = () => selectQuizOption(index, optBtn);
                optionsContainer.appendChild(optBtn);
            });
        }

        function selectQuizOption(selectedIndex, btnElement) {
            if (quizHasAnswered) return;
            quizHasAnswered = true;

            const questions = IPAS_CURRICULUM[currentActiveBab].kuis;
            const correctIndex = questions[quizCurrentQuestionIndex].correctAnswer;
            const allOptions = optionsContainer.children;

            // Feedback Visual
            if (selectedIndex === correctIndex) {
                btnElement.classList.remove('hover:border-brand-500', 'hover:bg-slate-50');
                btnElement.classList.add('correct');
                quizScore += 100 / questions.length;
            } else {
                btnElement.classList.remove('hover:border-brand-500', 'hover:bg-slate-50');
                btnElement.classList.add('wrong');
                // Highlight Correct Option in Green
                allOptions[correctIndex].classList.add('correct');
            }

            // Unhide Next button
            nextBtn.classList.remove('hidden');
            nextBtn.disabled = false;

            if (quizCurrentQuestionIndex === questions.length - 1) {
                nextBtn.innerHTML = 'Lihat Hasil Evaluasi <i class="fas fa-check-circle ml-1"></i>';
                nextBtn.classList.remove('bg-slate-900', 'hover:bg-slate-800');
                nextBtn.classList.add('bg-brand-600', 'hover:bg-brand-700');
            } else {
                nextBtn.innerHTML = 'Soal Berikutnya <i class="fas fa-arrow-right ml-1"></i>';
                nextBtn.classList.remove('bg-brand-600', 'hover:bg-brand-700');
                nextBtn.classList.add('bg-slate-900', 'hover:bg-slate-800');
            }
        }

        function nextQuestion() {
            const questions = IPAS_CURRICULUM[currentActiveBab].kuis;
            if (quizCurrentQuestionIndex < questions.length - 1) {
                quizCurrentQuestionIndex++;
                loadQuizQuestion();
            } else {
                showQuizResult();
            }
        }

        function showQuizResult() {
            questionScreen.classList.add('hidden');
            resultScreen.classList.remove('hidden');

            const scoreText = document.getElementById('final-score');
            const messageText = document.getElementById('result-message');
            const iconContainer = document.getElementById('result-icon');
            const labelText = document.getElementById('result-bab-label');

            const finalVal = Math.round(quizScore);
            scoreText.innerText = finalVal;
            labelText.innerText = IPAS_CURRICULUM[currentActiveBab].title;

            // Custom Message & Icons based on Score
            if (finalVal === 100) {
                messageText.innerText = "Sempurna! Anda berhasil menjawab semua soal dengan tepat. Tingkatkan terus kompetensi vokasi Anda!";
                iconContainer.innerHTML = '<i class="fas fa-trophy text-yellow-500"></i>';
                iconContainer.className = "w-20 h-20 rounded-2xl flex items-center justify-center text-4xl mx-auto mb-6 bg-yellow-100";
            } else if (finalVal >= 60) {
                messageText.innerText = "Hasil yang bagus! Anda sudah memahami konsep dasar bab ini. Kembangkan pemahaman lewat aktivitas projek.";
                iconContainer.innerHTML = '<i class="fas fa-thumbs-up text-brand-600"></i>';
                iconContainer.className = "w-20 h-20 rounded-2xl flex items-center justify-center text-4xl mx-auto mb-6 bg-brand-100";
            } else {
                messageText.innerText = "Yuk belajar lagi! Bacalah materi pada Modul Ajar, diskusikan dengan teman, lalu coba kuis ini kembali.";
                iconContainer.innerHTML = '<i class="fas fa-book-reader text-social-600"></i>';
                iconContainer.className = "w-20 h-20 rounded-2xl flex items-center justify-center text-4xl mx-auto mb-6 bg-social-100";
            }
        }

        function resetQuizState() {
            startScreen.classList.remove('hidden');
            questionScreen.classList.add('hidden');
            resultScreen.classList.add('hidden');
            quizCurrentQuestionIndex = 0;
            quizScore = 0;
            quizHasAnswered = false;
        }

        function resetQuiz() {
            resetQuizState();
